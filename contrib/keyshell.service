[Unit]
Description=keyshell launcher overlay
Documentation=https://github.com/darkliquid/keyshell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c keyshell --no-duplicate
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target